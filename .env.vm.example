# Reference copy of the production environment for the Azure VM.
#
# The real file lives on the server at /var/www/laravel/shared/.env and is generated
# by deploy/vm/bootstrap.sh in the frontend repo (it creates the MySQL user and a
# fresh APP_KEY). Each release symlinks to it, so it survives deploys.
# Never commit a filled-in copy.

APP_NAME="Kavindu Blog API"
APP_ENV=production
APP_KEY=                       # base64:... generated by bootstrap.sh
APP_DEBUG=false
APP_URL=http://<vm-ip-or-domain>

# Frontend and API share one origin behind nginx, so no cross-origin request is
# ever made. These stay set for correct absolute URL generation.
FRONTEND_URL=http://<vm-ip-or-domain>
CORS_ALLOWED_ORIGINS=http://<vm-ip-or-domain>

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1              # MySQL is local and bound to loopback only
DB_PORT=3306
DB_DATABASE=portfolioblog
DB_USERNAME=portfolioblog
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
